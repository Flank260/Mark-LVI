# MARK LVI — local secrets and user data must not be committed.
# Comments belong on separate lines; inline comments are part of a gitignore pattern.

# Secrets and linked accounts
config/api_keys.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*
!.env.example

# Personal assistant memory and conversation data
memory/long_term.json
memory/diario.jsonl
memory/*.db
memory/*.sqlite
memory/*.sqlite3
memory/*backup*
memory/*bak*
memory/backups/
config/acessos.json
config/exclusoes.json
config/organizacoes/
config/receitas/
config/vision_quota_state.json

# Runtime / local state
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.log
logs/
downloads/
screenshots/
